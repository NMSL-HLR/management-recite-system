      "chapterId": "ultimate-c3",
      "sections": 11,
      "checkpoints": 17,
      "sportsCheckpoints": [
        {
          "id": "mgt-ultimate-202610-q16-sport4-1",
          "sourceText": "2. 运动员选拔中，先要求基本测试合格，再按专项成绩综合排序，可用来说明结合式录用。"
        }
      ]
    },
    {
      "id": "mgt-ultimate-202610-q17",
      "title": "17　简述组织文化的构成、特征及塑造过程。",
      "kind": "full_answer",
      "chapterId": "ultimate-c4",
      "sections": 10,
      "checkpoints": 14,

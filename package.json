{
  "name": "pku346-recall",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "parse": "node scripts/parse-content.mjs && node scripts/parse-physiology.mjs",
    "pretest": "npm run parse",
    "test": "vitest run",
    "dev": "vite",

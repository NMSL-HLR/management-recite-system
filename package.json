    "package-release": "node scripts/package-fusion.mjs",
    "file-check:v222": "node scripts/file-protocol-check.mjs",
    "package-alpha-lite": "node scripts/package-alpha-lite.mjs",
    "package-fusion": "node scripts/package-fusion.mjs",
